<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% if title %}{{ title }} - {% endif %}{{ site.title }}</title>
    <meta name="description" content="{% if description %}{{ description }}{% else %}{{ site.description }}{% endif %}">
    <link rel="stylesheet" href="/css/style.css">
    <script data-goatcounter="https://emason.goatcounter.com/count"
        async src="//gc.zgo.at/count.js"></script>
</head>
<body>
    {% include "nav.njk" %}
    
    <main class="container">
        <article>
            {% if title %}<h1>{{ title }}</h1>{% endif %}
            {{ content | safe }}
        </article>
    </main>
    {% if comments %}
    <section class="comments" id="comments" data-post-id="{{ page.url }}">
        <div class="section-heading"><h2>Comments <span class="comment-count"></span></h2></div>
        <ol class="comment-list"></ol>
        <p class="comment-empty">No comments yet. Be the first.</p>

        <form class="comment-form" novalidate>
            <label for="comment-name">Name or nickname</label>
            <input id="comment-name" name="name" type="text" maxlength="50" autocomplete="nickname" required>

            <label for="comment-body">Comment</label>
            <textarea id="comment-body" name="body" rows="5" maxlength="5000" required></textarea>

            <div class="comment-hp" aria-hidden="true">
                <label for="comment-website">Leave this empty</label>
                <input id="comment-website" name="website" type="text" tabindex="-1" autocomplete="off">
            </div>

            <button type="submit">Post comment</button>
            <p class="comment-status" role="status" aria-live="polite"></p>
        </form>
        <script src="/js/comments.js" defer></script>
    </section>
    {% endif %}
</body>
</html>
